# --- Who may use the tool (Auth.js sign-in) -------------------------------
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional — derived from GRAPH_TENANT_ID when omitted.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Comma-separated allowlist. Empty = nobody gets in (fails closed).
ALLOWED_USERS=chris.kim@coverdash.com

# --- Graph app-only credentials (the calendar writes) ---------------------
# Application permissions, admin consented:
#   Calendars.ReadWrite, User.Read.All, Group.Read.All
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Optional UI prefill --------------------------------------------------
ONBOARDING_PRESETS=veronica.r@coverdash.com
